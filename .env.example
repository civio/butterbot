# Copy to .env and fill in, then `source .env` before starting Butterbot.
# .env is gitignored: it holds live credentials and per-machine settings.

# --- Slack -------------------------------------------------------------------
# From the Slack app config (README, "Create the Slack app"). The app-level
# token needs the connections:write scope; the bot token is the "Bot User
# OAuth Token" under OAuth & Permissions.
export BUTTERBOT_SLACK_APP_TOKEN=xapp-...
export BUTTERBOT_SLACK_BOT_TOKEN=xoxb-...

# --- Local server auth -------------------------------------------------------
# Only if the local server is configured to require an API key. Leave unset
# otherwise; a 401 on the bot's first reply is the symptom of a missing key.
# export BUTTERBOT_LOCAL_API_KEY=

# --- Cloud providers ---------------------------------------------------------
# Only read when started with --provider=anthropic (other catalog providers
# have their own key variable).
# export ANTHROPIC_API_KEY=

# --- System prompt -----------------------------------------------------------
# Replaces the built-in base prompt; environment and skills sections are still
# appended. env var rather than a flag because it is too long for command line.
# export BUTTERBOT_SYSTEM_PROMPT=

# --- npm start ---------------------------------------------------------------
# Read by the start scripts, not by Butterbot itself: `npm start` expands these
# into `node src/main.js` flags, and refuses to run with the first three unset.
# The model id differs per machine; for --provider=local it must be exactly
# as the server names it — check with: curl localhost:1234/v1/models
export BUTTERBOT_SANDBOX_CONTAINER=butterbot-sandbox
export BUTTERBOT_WORKSPACE=./workspace-example
export BUTTERBOT_MODEL=

# Optional, and left out of the command line when empty, so that Butterbot's own
# defaults apply: the provider, and the endpoint a local one is on.
# export BUTTERBOT_PROVIDER=local
# export BUTTERBOT_BASE_URL=http://localhost:1234
